# ShopSphere FullStack Environment Configuration Template
# Copy this file to .env and fill in your values for docker-compose or local runs

# Database configuration
DB_NAME=shopsphere
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Secret (minimum 256 bits / 32 bytes)
JWT_SECRET=replace_with_a_long_random_hex_or_base64_string_at_least_32_bytes

# Razorpay Payment Gateway (Test or Live keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Gmail SMTP Email configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
MAIL_ENABLED=false
