# ===============================================================
# ShopSphere Local Secrets Template
# Copy this file to 'application-secrets.properties' (git-ignored)
# and fill in your actual credentials.
# ===============================================================

# --- PostgreSQL Database ---
# spring.datasource.password=postgres

# --- JWT Signing Secret (must be at least 32 characters) ---
# jwt.secret=change-this-to-a-secure-random-64-character-string-for-production

# --- Razorpay Payment Gateway ---
# razorpay.key.id=rzp_test_yourKeyId
# razorpay.key.secret=yourRazorpaySecret
# razorpay.webhook.secret=yourWebhookSecret

# --- Gmail SMTP (Requires an App Password, not normal account password) ---
# spring.mail.username=your-email@gmail.com
# spring.mail.password=your-16-char-app-password
# app.mail.enabled=true
